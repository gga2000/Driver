{
  "name": "driver",
  "private": true,
  "version": "0.1.0",
  "description": "Driver (درايفر) — hyperlocal delivery and mobility platform for Iraq",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "lint": "turbo run lint",
    "db:up": "docker compose up -d --wait postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @driver/db migrate:deploy",
    "db:drift": "pnpm --filter @driver/db migrate:drift",
    "db:reset": "pnpm --filter @driver/db migrate:reset",
    "db:seed": "pnpm --filter @driver/db seed",
    "db:studio": "pnpm --filter @driver/db studio",
    "sim": "pnpm --filter @driver/api sim",
    "dev:api": "pnpm --filter @driver/api dev",
    "dev:console": "pnpm --filter @driver/console dev",
    "studio": "node scripts/dev/studio.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\""
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "@nestjs/platform-express>multer": "2.4.0",
      "@nestjs/platform-express>body-parser": "1.20.8",
      "express>body-parser": "1.20.8",
      "body-parser>qs": "6.16.0",
      "express>qs": "6.16.0",
      "next>postcss": "8.5.29"
    }
  }
}
