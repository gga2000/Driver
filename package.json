{
  "name": "driver",
  "private": true,
  "version": "0.1.0",
  "description": "Driver (\u062f\u0631\u0627\u064a\u0641\u0631) \u2014 hyperlocal delivery and mobility platform for Iraq",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:up": "docker compose up -d --wait postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @driver/db migrate:deploy",
    "db:reset": "pnpm --filter @driver/db migrate:reset",
    "db:seed": "pnpm --filter @driver/db seed",
    "db:studio": "pnpm --filter @driver/db studio",
    "sim": "pnpm --filter @driver/api sim",
    "dev:api": "pnpm --filter @driver/api dev",
    "dev:console": "pnpm --filter @driver/console dev",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\""
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
