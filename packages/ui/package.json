{
  "name": "@driver/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Driver design system — React Native components, icons and motion shared by the customer, partner and merchant apps (RTL-first, runs on react-native-web)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src gallery",
    "gallery": "vite build",
    "gallery:dev": "vite",
    "gallery:shots": "node gallery/screenshot.mjs"
  },
  "dependencies": {
    "@driver/contracts": "workspace:*",
    "@driver/design-tokens": "workspace:*",
    "@driver/i18n": "workspace:*"
  },
  "peerDependencies": {
    "@react-native-community/netinfo": "11.4.1",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "2.24.0",
    "react-native-reanimated": "3.17.5",
    "react-native-safe-area-context": "5.4.0",
    "react-native-svg": "15.11.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "9.39.5",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@react-native-community/netinfo": "11.4.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.0.14",
    "@types/react-dom": "19.0.6",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "26.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "2.24.0",
    "react-native-reanimated": "3.17.5",
    "react-native-safe-area-context": "5.4.0",
    "react-native-svg": "15.11.2",
    "react-native-web": "0.20.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
