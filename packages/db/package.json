{
  "name": "@driver/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema and generated client for Driver (Postgres + PostGIS)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma validate && tsc -p tsconfig.json --noEmit",
    "generate": "prisma generate",
    "validate": "prisma validate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:drift": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "migrate:reset": "prisma migrate reset --force --skip-seed",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@driver/contracts": "workspace:*",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
