  @@index([driverId, state])
  @@map("dispatch_offers")
  @@schema("public")
}

// ═════════════════════════════ Partner & Merchant apps, wave 2 ═════════════════════════════
// No relations to `orgs` on purpose: orgs still live in memory (OrgsService), so org ids here are
// plain indexed columns. Photos are upload ids from the signed-PUT store; driver documents' and
// selfies' refs live in the vault (person_identities.document_refs / selfie_refs), not here.

enum DriverDocumentKind {
  national_id_front
  national_id_back
  licence
  vehicle_registration
  insurance
  photo

  @@schema("public")
}

enum DriverDocumentStatus {
  pending
  approved
  rejected

  @@schema("public")
}

/// A driver's document submission (scoring §2): status and expiry only. Expiring (≤ 30 days) and
/// expired are derived from `expires_at`; expired → offline.
model DriverDocument {
  id           String               @id @default(cuid())
  personId     String               @map("person_id")
  kind         DriverDocumentKind
  status       DriverDocumentStatus @default(pending)
  expiresAt    DateTime?            @map("expires_at")
  submittedAt  DateTime             @map("submitted_at")
  reviewedAt   DateTime?            @map("reviewed_at")
  reviewedById String?              @map("reviewed_by_id")
  rejectReason String?              @map("reject_reason")
  /// A newer submission of the same kind replaced this one.
  supersededAt DateTime?            @map("superseded_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@index([personId, kind])
  @@index([status, expiresAt])
  @@map("driver_documents")
  @@schema("public")
}

enum DriverCheckInResult {
  pending
  passed
  failed

  @@schema("public")
}

/// Daily liveness selfie (scoring §2): one row per challenge; two failures a day → offline + ops alert.
model DriverCheckIn {
  id            String              @id @default(cuid())
  personId      String              @map("person_id")
  /// Baghdad local date, YYYY-MM-DD.
  localDate     String              @map("local_date")
  gesture       String
  issuedAt      DateTime            @map("issued_at")
  expiresAt     DateTime            @map("expires_at")
  result        DriverCheckInResult @default(pending)
  submittedAt   DateTime?           @map("submitted_at")
  livenessScore Float?              @map("liveness_score")
  failureReason String?             @map("failure_reason")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([personId, localDate])
  @@map("driver_check_ins")
  @@schema("public")
}

/// A child reported absent for one خطوط run (edge-case §5): the child's stops on that trip are skipped.
model KhatAbsence {
  id             String   @id @default(cuid())
  tripId         String   @map("trip_id")
  /// Opaque vault ref (vault.child_identities.id); never the name.
  childRef       String   @map("child_ref")
  localDate      String   @map("local_date")
  reportedById   String   @map("reported_by_id")
  reason         String
  note           String?
  skippedStopIds String[] @default([]) @map("skipped_stop_ids")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([tripId, childRef])
  @@index([childRef, localDate])
  @@map("khat_absences")
  @@schema("public")
}

/// A خطوط run that ended without the "car is empty" sweep within `KHAT_RULES.sweepAlertAfterMin`
/// (partner S-6, Ali 2026-10-06): one row per run (raised once), cleared by the driver's late confirm.
/// Pseudonymous: person ids only; names come from the vault when the Console reads it.
model KhatSweepAlert {
  id            String    @id @default(cuid())
  tripId        String    @unique @map("trip_id")
  cityId        String    @map("city_id")
  driverId      String    @map("driver_id")
  childrenTotal Int       @map("children_total")
  lastDropAt    DateTime? @map("last_drop_at")
  lastDropZone  String?   @map("last_drop_zone")
  runEndedAt    DateTime  @map("run_ended_at")
  raisedAt      DateTime  @map("raised_at")
  confirmedAt   DateTime? @map("confirmed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([cityId, raisedAt])
  @@map("khat_sweep_alerts")
  @@schema("public")
}

/// A driver working for a fleet org (partner spec: fleet owner dashboard). Vehicles stay in `vehicles`.
model FleetDriver {
  id         String    @id @default(cuid())
  fleetOrgId String    @map("fleet_org_id")
  personId   String    @map("person_id")
  addedById  String    @map("added_by_id")
  /// Review 2026-10-04: the driver's own yes to the fleet; null = invited, the owner sees nothing yet.
  acceptedAt DateTime? @map("accepted_at")
  removedAt  DateTime? @map("removed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([fleetOrgId, personId])
  @@index([personId])
  @@map("fleet_drivers")
  @@schema("public")
}

/// A landmark / place / meeting-point photo proposed by field ops (domain §7); the Console approves.
model LandmarkPhoto {
  id           String    @id @default(cuid())
  targetKind   String    @map("target_kind")
  targetId     String    @map("target_id")
  uploadId     String    @map("upload_id")
  caption      String?
  localNames   String[]  @default([]) @map("local_names")
  state        String    @default("proposed")
  addedById    String    @map("added_by_id")
  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  rejectReason String?   @map("reject_reason")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([targetKind, targetId])
  @@index([state, createdAt])
  @@map("landmark_photos")
  @@schema("public")
}

/// Courier → field ops cash hand-over (money §4 channel 1). The money is the ledger's `driver_settlement`
/// under `reference`; this row is the receipt (both confirmations, WhatsApp receipt).
model OpsCashReceipt {
  id                  String   @id @default(cuid())
  courierId           String   @map("courier_id")
  receivedById        String   @map("received_by_id")
  amountIqd           Int      @map("amount_iqd")
  reference           String   @unique
  idempotencyKey      String?  @unique @map("idempotency_key")
  note                String?
  courierCashAfterIqd Int      @map("courier_cash_after_iqd")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([courierId, createdAt])
  @@index([receivedById, createdAt])
  @@map("ops_cash_receipts")
  @@schema("public")
}

/// Wallet top-up with cash (money §4): the customer's 6-digit code, confirmed once by an ops agent or
/// the courier on his next order; the ledger credit is posting group `topup:<id>`.
model WalletTopUp {
  id             String    @id @default(cuid())
  customerId     String    @map("customer_id")
  amountIqd      Int       @map("amount_iqd")
  code           String
