}

// ═════════════════════════════ Notifications (domain §8, notify module) ═════════════════════════════

/// A push token of one app install (Expo push token or raw FCM token). Tied to the session that
/// registered it: signing out removes it; a token moving to another person or session is reassigned.
model PushToken {
  id         String   @id @default(cuid())
  token      String   @unique
  /// `expo` | `fcm`
  kind       String
  personId   String   @map("person_id")
  sessionId  String?  @map("session_id")
  /// `customer` | `partner` | `merchant`
  app        String
  /// `ios` | `android` | `web`
  platform   String
  appVersion String?  @map("app_version")
  lastSeenAt DateTime @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([personId, app])
  @@index([sessionId])
  @@map("push_tokens")
  @@schema("public")
}

/// Per-person notification switches (absent row = defaults; marketing is opt-in).
model NotifyPreference {
  id               String   @id @default(cuid())
  personId         String   @unique @map("person_id")
  orderUpdates     Boolean  @default(true) @map("order_updates")
  chat             Boolean  @default(true)
  whatsappReceipts Boolean  @default(true) @map("whatsapp_receipts")
  smsFallback      Boolean  @default(true) @map("sms_fallback")
  marketing        Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("notify_preferences")
  @@schema("public")
}

/// One message on one channel to one person. `dedupe_key` = event id + template + person: an outbox
/// redelivery finds its rows and sends nothing twice. `payload` holds what was rendered (title, body,
/// WhatsApp params, deep link), never the phone number; `tickets` the push tickets per token.
model NotifyDelivery {
  id          String    @id @default(cuid())
  dedupeKey   String    @map("dedupe_key")
  eventId     String    @map("event_id")
  template    String
  personId    String    @map("person_id")
  orderId     String?   @map("order_id")
  channel     String
  /// queued | deferred | sent | delivered | read | failed | suppressed | skipped
  status      String
  reason      String?
  provider    String?
  /// Provider message id (WhatsApp wamid, SMS id, first push ticket): status callbacks find the row by it.
  providerRef String?   @map("provider_ref")
  tickets     Json?
  attempts    Int       @default(0)
  twin        Boolean   @default(false)
  payload     Json
  notBefore   DateTime? @map("not_before")
  sentAt      DateTime? @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([dedupeKey, channel])
  @@index([personId, createdAt])
  @@index([orderId, createdAt])
  @@index([providerRef])
  @@map("notify_deliveries")
  @@schema("public")
}

/// "خبرني لمن ينفتح" on the customer home's coming-soon tiles: one row per person and service
/// (`grocery` | `khat` | `parcel`); asking again refreshes `updated_at` and the zone. The Console reads
/// the counts per service and zone (`notify.launchDemand`); the launch push goes to these people.
model LaunchInterest {
  id        String   @id @default(cuid())
  personId  String   @map("person_id")
  service   String
  /// Zone of the person's deliver-to place when they asked (null = no place yet).
  zoneKey   String?  @map("zone_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([personId, service])
  @@index([service, zoneKey])
  @@map("launch_interests")
  @@schema("public")
}

// ───────────────────────── launch control room ─────────────────────────

/// Kill switch (launch playbook §3): one row per target `<scope>:<key>:<vertical|*>` in a city. Turning it
/// off keeps the row (active = false) so the console shows who switched what back and when.
model OpsKillSwitch {
  id           String    @id @default(cuid())
  cityId       String    @map("city_id")
  /// vertical | zone | restaurant | corridor
  scope        String
  key          String
  /// Zone switches may stop one vertical only; NULL = every vertical.
  vertical     String?
  target       String
  active       Boolean   @default(true)
  /// Also hold automatic dispatch offers in this scope (new jobs go suggest-only to the dispatcher).
  holdDispatch Boolean   @default(false) @map("hold_dispatch")
  messageAr    String?   @map("message_ar")
  reason       String
  setById      String    @map("set_by_id")
  setAt        DateTime  @map("set_at")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([cityId, target])
  @@index([cityId, active])
  @@map("ops_kill_switches")
  @@schema("public")
}

/// Capacity throttle per zone (launch playbook §3): max concurrent active orders and the honest wait.
model OpsZoneCapacity {
  id        String   @id @default(cuid())
  cityId    String   @map("city_id")
  zoneKey   String   @map("zone_key")
  /// NULL = no throttle.
  maxActive Int?     @map("max_active")
  /// refuse | queue
  mode      String   @default("refuse")
  etaMin    Int      @default(15) @map("eta_min")
  setById   String   @map("set_by_id")
  setAt     DateTime @map("set_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([cityId, zoneKey])
  @@map("ops_zone_capacities")
  @@schema("public")
}

/// Status banner broadcast to every open app (customer / partner / merchant); always expires.
model SystemBanner {
  id          String    @id @default(cuid())
  /// NULL = every city.
  cityId      String?   @map("city_id")
  /// info | warning | critical
  severity    String
  audiences   String[]  @default([])
  messageAr   String    @map("message_ar")
  messageEn   String?   @map("message_en")
  startsAt    DateTime  @map("starts_at")
  expiresAt   DateTime  @map("expires_at")
  setById     String    @map("set_by_id")
  clearedAt   DateTime? @map("cleared_at")
  clearedById String?   @map("cleared_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("system_banners")
  @@schema("public")
}

/// Quiet days (customer joy J1a): mourning days ops set in the Console. While one is on, the apps play
/// no celebrations or moment sounds and the notify engine sends no offers.
model QuietPeriod {
  id          String    @id @default(cuid())
  /// NULL = every city.
  cityId      String?   @map("city_id")
  /// Baghdad calendar days, inclusive, as YYYY-MM-DD.
  startsOn    String    @map("starts_on")
  endsOn      String    @map("ends_on")
  labelAr     String    @map("label_ar")
  setById     String    @map("set_by_id")
  clearedAt   DateTime? @map("cleared_at")
  clearedById String?   @map("cleared_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([endsOn])
  @@map("quiet_periods")
  @@schema("public")
}

/// Console audit log (console spec, system/admin): every control-room action, who did it, on what.
model ConsoleAuditLog {
  id          String   @id @default(cuid())
  cityId      String?  @map("city_id")
  actorId     String   @map("actor_id")
  action      String
  subjectKind String   @map("subject_kind")
  subjectId   String   @map("subject_id")
  summaryAr   String   @map("summary_ar")
  detail      Json     @default("{}")
  at          DateTime
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([at])
  @@index([subjectKind, at])
  @@map("console_audit_log")
  @@schema("public")
}

/// Support ticket (notifications & support §2): disputes open one by themselves (`source_key`).
model SupportTicket {
  id              String    @id @default(cuid())
  cityId          String    @map("city_id")
  /// dispute | complaint | incident | question
  kind            String
  /// open | waiting | escalated | resolved
  status          String    @default("open")
  /// in_app | whatsapp | phone | system
  channel         String
  subject         String
  orderId         String?   @map("order_id")
  tripId          String?   @map("trip_id")
  customerId      String?   @map("customer_id")
  openedById      String    @map("opened_by_id")
  openedAt        DateTime  @map("opened_at")
  firstResponseAt DateTime? @map("first_response_at")
  resolvedAt      DateTime? @map("resolved_at")
  slaDueAt        DateTime  @map("sla_due_at")
  assigneeId      String?   @map("assignee_id")
  /// none | courier | merchant | platform | customer
  faultParty      String    @default("none") @map("fault_party")
  refundedIqd     Int       @default(0) @map("refunded_iqd")
  escalatedTo     String?   @map("escalated_to")
  escalatedAt     DateTime? @map("escalated_at")
  resolution      String?
  /// Idempotent auto-open (`dispute:<orderId>`); NULL for tickets opened by hand.
  sourceKey       String?   @unique @map("source_key")
  reopenCount     Int       @default(0) @map("reopen_count")
  lastActivityAt  DateTime  @map("last_activity_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  entries SupportTicketEntry[]

  @@index([status, openedAt])
  @@index([orderId])
  @@index([customerId, openedAt])
  @@map("support_tickets")
  @@schema("public")
}

/// A ticket's history: replies, notes, refunds (ledger group in meta), fault, escalation, resolution.
model SupportTicketEntry {
  id             String   @id @default(cuid())
  ticketId       String   @map("ticket_id")
  actorId        String   @map("actor_id")
  /// opened | note | reply | refund | fault | escalate | resolve | reopen | assign
  kind           String
  text           String
  amountIqd      Int?     @map("amount_iqd")
  meta           Json     @default("{}")
  idempotencyKey String?  @unique @map("idempotency_key")
  at             DateTime
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, at])
  @@index([actorId, kind, at])
  @@map("support_ticket_entries")
  @@schema("public")
}
