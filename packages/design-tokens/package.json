{
  "name": "@driver/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens for Driver — colors, spacing, radii, Arabic-first type scale, motion",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.json": "./tokens.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/emit-json.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
