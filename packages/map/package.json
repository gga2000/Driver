{
  "name": "@driver/map",
  "version": "0.1.0",
  "private": true,
  "description": "MapLibre style (style as code), Aziziyah bounds, zone and garage GeoJSON for Driver maps",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.json": "./dist/style.json",
    "./golden": {
      "types": "./dist/golden/index.d.ts",
      "default": "./dist/golden/index.js"
    },
    "./pieces": {
      "types": "./dist/golden/pieces.d.ts",
      "default": "./dist/golden/pieces.js"
    },
    "./pieces/walk": {
      "types": "./dist/golden/walk.d.ts",
      "default": "./dist/golden/walk.js"
    },
    "./pieces/moments": {
      "types": "./dist/golden/moments.d.ts",
      "default": "./dist/golden/moments.js"
    },
    "./pieces/garage-seats": {
      "types": "./dist/golden/garage-seats.d.ts",
      "default": "./dist/golden/garage-seats.js"
    },
    "./pieces/khat": {
      "types": "./dist/golden/khat.d.ts",
      "default": "./dist/golden/khat.js"
    },
    "./pieces/demand": {
      "types": "./dist/golden/demand.d.ts",
      "default": "./dist/golden/demand.js"
    },
    "./pieces/sunrise": {
      "types": "./dist/golden/sunrise.d.ts",
      "default": "./dist/golden/sunrise.js"
    },
    "./pieces/my-trips": {
      "types": "./dist/golden/my-trips.d.ts",
      "default": "./dist/golden/my-trips.js"
    },
    "./pieces/road": {
      "types": "./dist/golden/road.d.ts",
      "default": "./dist/golden/road.js"
    },
    "./pieces/carts": {
      "types": "./dist/golden/carts.d.ts",
      "default": "./dist/golden/carts.js"
    },
    "./pieces/closed-streets": {
      "types": "./dist/golden/closed-streets.d.ts",
      "default": "./dist/golden/closed-streets.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/emit-style.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@driver/contracts": "workspace:*",
    "@driver/design-tokens": "workspace:*",
    "@maplibre/maplibre-gl-style-spec": "24.10.0",
    "@types/geojson": "7946.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "3.2.7"
  }
}
