{
  "name": "@driver/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared zod schemas, TS types and the tRPC AppRouter type for Driver",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "default": "./dist/router.js"
    },
    "./seeds": {
      "types": "./dist/seeds/aziziyah-restaurants.d.ts",
      "default": "./dist/seeds/aziziyah-restaurants.js"
    },
    "./live-client": {
      "types": "./dist/live-client.d.ts",
      "default": "./dist/live-client.js"
    },
    "./net-client": {
      "types": "./dist/net-client.d.ts",
      "default": "./dist/net-client.js"
    },
    "./crash-report": {
      "types": "./dist/crash-report.d.ts",
      "default": "./dist/crash-report.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@driver/i18n": "workspace:*",
    "@trpc/server": "11.19.0",
    "superjson": "2.2.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "3.2.7"
  }
}
