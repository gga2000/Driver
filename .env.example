# Copy to .env (git-ignored). Values match docker-compose.yml.

# Postgres + PostGIS. Prisma manages both the `public` and `vault` schemas.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/driver"

# Throwaway database that `prisma migrate diff --from-migrations` replays the migrations into for the drift
# check (`pnpm db:drift`, CI step 5). docker-compose creates it on a fresh volume; never point it at real data.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/driver_shadow"

# Road routing (OSRM, docs/deploy/hosting.md "Road routing"). Unset: arrival times use the shared
# straight-line estimate. Local test against the public demo server (light use only):
#   OSRM_URL=https://router.project-osrm.org
# OSRM_URL=http://driver-osrm.internal:5000
# OSRM_TIMEOUT_MS=1500

# Redis for BullMQ (outbox publisher, dispatch timers, order timers) and the driver GEO index.
REDIS_URL="redis://localhost:6379"
# Which background work this process runs: all (default: everything), web (requests only, enqueues jobs)
# or worker (runs the jobs). web and worker need REDIS_URL. Production sets it per Fly process group.
# DRIVER_ROLE="all"
# Durable timers (public.scheduled_timers): on = a sweeper fires due timers even when Redis is gone. Default off.
# TIMERS_SWEEPER="off"
# TIMERS_SWEEP_MS=5000

# Signs access and refresh tokens (Step 2). Any long random string in development.
# With NODE_ENV=production the API refuses to boot unless JWT_SECRET and PHONE_HASH_PEPPER are both
# set, at least 32 characters, and not the placeholder values below.
JWT_SECRET="change-me-in-production-please-32-chars-min"

# Key id in the JWT header; bump when rotating JWT_SECRET.
JWT_KID=k1

# Pepper for phone-number hashes (vault). Defaults to JWT_SECRET outside production (required there);
# changing it orphans every person.
PHONE_HASH_PEPPER="change-me-too-and-never-again"

# SMS (OTP codes and the SMS twins of important notifications) — apps/api/src/shared/messaging/sms.ts.
#   dev     prints every SMS (OTP codes included) in the API terminal; identity.devLastOtp reads the codes
#   http    any HTTP gateway (Iraqi aggregators): URL / body templates with {to} {text} {sender}
#   twilio  Twilio or a Twilio-compatible API
# The old names still work: SMS_PROVIDER=fake → dev, gateway → http (SMS_GATEWAY_URL / SMS_GATEWAY_KEY).
SMS_PROVIDER=dev
# SMS_SENDER_ID=Driver
# SMS_HTTP_URL="https://sms.example.iq/api/send"          # GET gateways: "https://gw.example.iq/send?to={to}&msg={text}&sid={sender}"
# SMS_HTTP_METHOD=POST                                     # GET | POST
# SMS_HTTP_BODY='{"to":"{to}","text":"{text}","sender":"{sender}"}'   # POST body template (JSON-escaped, or URL-encoded for a form type)
# SMS_HTTP_CONTENT_TYPE=application/json                   # or application/x-www-form-urlencoded
# SMS_HTTP_AUTH_HEADER="Authorization: Bearer <key>"       # any one header line, e.g. "X-API-Key: <key>"
# SMS_HTTP_NUMBER_FORMAT=e164                              # e164 (+9647…) | digits (9647…) | local (07…)
# SMS_HTTP_SUCCESS_REGEX=                                  # optional: a 2xx body must match (e.g. ^OK)
# SMS_HTTP_ID_PATH=                                        # optional: message id in a JSON answer (e.g. data.id)
# SMS_TWILIO_ACCOUNT_SID=
# SMS_TWILIO_AUTH_TOKEN=
# SMS_TWILIO_FROM=                                         # or SMS_TWILIO_MESSAGING_SERVICE_SID
# SMS_TWILIO_BASE_URL=https://api.twilio.com               # a Twilio-compatible vendor's base URL

# Push (apps/api/src/modules/notify). Expo push tokens go through PUSH_PROVIDER: dev (log only, default)
# or expo (Expo Push API; picked automatically when EXPO_ACCESS_TOKEN is set). Raw FCM tokens go through
# FCM HTTP v1 when FCM_PROJECT_ID and a credential are set (else dev).
# PUSH_PROVIDER=dev
# EXPO_ACCESS_TOKEN=                                       # needed when the Expo project has enhanced push security on
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_JSON=                                # the service-account JSON (client_email, private_key), one line
# FCM_ACCESS_TOKEN=                                        # or a ready OAuth token (short-lived)

# WhatsApp Business Cloud API (receipts, guardian alerts). dev logs; meta sends (picked automatically when
# WHATSAPP_TOKEN is set). Templates to submit: docs/whatsapp-templates.md.
# WHATSAPP_PROVIDER=dev
# WHATSAPP_TOKEN=                                          # system-user access token
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_APP_SECRET=                                     # enables the /webhooks/whatsapp status callbacks (signature check)
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=                           # the GET handshake token you type in the Meta app

# Notification delivery tuning (defaults shown).
# NOTIFY_RECEIPT_BASE_URL=https://driver.iq/r/             # receipt links in WhatsApp receipts (+ order id)
# NOTIFY_RETRY_BASE_MS=2000                                # first retry; doubles per attempt, capped at 10 min
# NOTIFY_MAX_ATTEMPTS=6
# NOTIFY_RECEIPT_DELAY_SEC=900                             # Expo receipt poll for pushes without an SMS twin

# OTP request limits per hour (counted in Redis when REDIS_URL is set): per client IP, per device.
# OTP_RATE_LIMIT_PER_IP_HOUR=10
# OTP_RATE_LIMIT_PER_DEVICE_HOUR=5
# Behind a load balancer: proxy hops to trust for the client IP (X-Forwarded-For), e.g. 1.
# TRUST_PROXY=

# Photo storage (docs/persistence.md). With all four S3_* set, uploads go straight to a private
# S3-compatible bucket (Supabase Storage, Cloudflare R2, MinIO) through presigned PUT/GET URLs; otherwise
# the API keeps the bytes itself: in memory, and on disk under UPLOADS_DIR when set.
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"   # Supabase: https://<project>.supabase.co/storage/v1/s3
# S3_BUCKET=driver-photos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto                 # R2: auto; Supabase: the project's region (Frankfurt: eu-central-1)
# S3_FORCE_PATH_STYLE=true       # path-style URLs (Supabase and MinIO need it, R2 accepts it)
# UPLOADS_DIR=./.uploads
# UPLOADS_PUBLIC_ORIGIN=http://localhost:3000
# UPLOADS_SECRET=                # signs /uploads and /files URLs; defaults to JWT_SECRET

# API port and the URL the Console/apps call.
PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:3000/trpc"

# ───────────── Production / hosting (docs/deploy/*.md; none of these is needed on a laptop) ─────────────
# Supabase: DATABASE_URL is the pooler in transaction mode (port 6543, user postgres.<ref>) for the API;
# DIRECT_URL is the direct or session connection (port 5432) that `prisma migrate deploy` and the seed
# use (packages/db/prisma.config.ts prefers it). Unset here: DATABASE_URL serves both.
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"
# PEM of Supabase's CA (Project Settings → Database → SSL): TLS verified against it. `\n` escapes accepted.
# DATABASE_CA_CERT=
# Pooled connections per API process (node-postgres default 10).
# DATABASE_POOL_MAX=10
# Browser origins allowed to call the API (comma-separated); unset = any origin.
# CORS_ORIGINS=https://app.example.com,https://console.example.com
# json (default with NODE_ENV=production) or pretty; LOG_LEVEL=debug adds debug/verbose.
# LOG_FORMAT=json
# LOG_LEVEL=
# Optional error reporting; nothing is sent without it.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# APP_RELEASE=                   # set by the deploy workflow (tag@sha), shown in Sentry
# SIGTERM → drain → exit within this many ms (keep under the host's kill timeout, Fly: 30 s).
# SHUTDOWN_TIMEOUT_MS=25000
# Seed (`pnpm db:seed`, scripts/deploy/supabase-setup.mjs): production skips the demo restaurant and
# the demo dispatcher; SEED_ADMIN_PHONE (your mobile) becomes admin + dispatcher + support + finance.
# SEED_PROFILE=production
# SEED_ADMIN_PHONE=07XXXXXXXXX
# SEED_ADMIN_NAME=
# Build-time, not runtime: the Expo apps read EXPO_PUBLIC_API_URL / EXPO_PUBLIC_SHARE_BASE_URL when
# bundling (web export, EAS); the Console reads NEXT_PUBLIC_API_URL and NEXT_OUTPUT=standalone in `next build`.
# EXPO_PUBLIC_API_URL=https://api.example.com/trpc
# EXPO_PUBLIC_SHARE_BASE_URL=https://app.example.com
# Crash reports from the phone apps and the Console (docs/deploy/hosting.md "Logs and errors"), also
# build-time; unset = nothing is sent. One Sentry project per app is easiest to read.
# EXPO_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.de.sentry.io/<project>
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=production       # default: development in `expo start`, production in builds
# EXPO_PUBLIC_APP_RELEASE=                        # default: iq.driver.<app>@<app.json version>
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.de.sentry.io/<project>
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production       # default: NODE_ENV
# NEXT_PUBLIC_APP_RELEASE=                        # default: driver-console@<package.json version>
# NEXT_OUTPUT=standalone

# Offline Prisma CLI (no engine download, no database) — only for CI/sandboxes without Postgres.
# PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1
# PRISMA_SCHEMA_ENGINE_BINARY=/bin/true
