# Copy to .env (git-ignored). Values match docker-compose.yml.

# Postgres + PostGIS. Prisma manages both the `public` and `vault` schemas.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/driver"

# Throwaway database that `prisma migrate diff --from-migrations` replays the migrations into for the drift
# check (`pnpm db:drift`, CI step 5). docker-compose creates it on a fresh volume; never point it at real data.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/driver_shadow"

# Redis for BullMQ (outbox publisher, dispatch timers, order timers) and the driver GEO index.
REDIS_URL="redis://localhost:6379"

# Signs access and refresh tokens (Step 2). Any long random string in development.
# With NODE_ENV=production the API refuses to boot unless JWT_SECRET and PHONE_HASH_PEPPER are both
# set, at least 32 characters, and not the placeholder values below.
JWT_SECRET="change-me-in-production-please-32-chars-min"

# Key id in the JWT header; bump when rotating JWT_SECRET.
JWT_KID=k1

# Pepper for phone-number hashes (vault). Defaults to JWT_SECRET outside production (required there);
# changing it orphans every person.
PHONE_HASH_PEPPER="change-me-too-and-never-again"

# `fake` prints OTP codes in the API terminal; `gateway` sends real SMS (needs SMS_GATEWAY_URL/KEY, M3).
SMS_PROVIDER=fake
# SMS_GATEWAY_URL=
# SMS_GATEWAY_KEY=

# OTP request limits per hour (counted in Redis when REDIS_URL is set): per client IP, per device.
# OTP_RATE_LIMIT_PER_IP_HOUR=10
# OTP_RATE_LIMIT_PER_DEVICE_HOUR=5
# Behind a load balancer: proxy hops to trust for the client IP (X-Forwarded-For), e.g. 1.
# TRUST_PROXY=

# Photo storage (docs/persistence.md). With all four S3_* set, uploads go straight to a private
# S3-compatible bucket (Supabase Storage, Cloudflare R2, MinIO) through presigned PUT/GET URLs; otherwise
# the API keeps the bytes itself: in memory, and on disk under UPLOADS_DIR when set.
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"   # Supabase: https://<project>.supabase.co/storage/v1/s3
# S3_BUCKET=driver-photos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto                 # R2: auto; Supabase: the project's region (Frankfurt: eu-central-1)
# S3_FORCE_PATH_STYLE=true       # path-style URLs (Supabase and MinIO need it, R2 accepts it)
# UPLOADS_DIR=./.uploads
# UPLOADS_PUBLIC_ORIGIN=http://localhost:3000
# UPLOADS_SECRET=                # signs /uploads and /files URLs; defaults to JWT_SECRET

# API port and the URL the Console/apps call.
PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:3000/trpc"

# ───────────── Production / hosting (docs/deploy/*.md; none of these is needed on a laptop) ─────────────
# Supabase: DATABASE_URL is the pooler in transaction mode (port 6543, user postgres.<ref>) for the API;
# DIRECT_URL is the direct or session connection (port 5432) that `prisma migrate deploy` and the seed
# use (packages/db/prisma.config.ts prefers it). Unset here: DATABASE_URL serves both.
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"
# PEM of Supabase's CA (Project Settings → Database → SSL): TLS verified against it. `\n` escapes accepted.
# DATABASE_CA_CERT=
# Pooled connections per API process (node-postgres default 10).
# DATABASE_POOL_MAX=10
# Browser origins allowed to call the API (comma-separated); unset = any origin.
# CORS_ORIGINS=https://app.example.com,https://console.example.com
# json (default with NODE_ENV=production) or pretty; LOG_LEVEL=debug adds debug/verbose.
# LOG_FORMAT=json
# LOG_LEVEL=
# Optional error reporting; nothing is sent without it.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# APP_RELEASE=                   # set by the deploy workflow (tag@sha), shown in Sentry
# SIGTERM → drain → exit within this many ms (keep under the host's kill timeout, Fly: 30 s).
# SHUTDOWN_TIMEOUT_MS=25000
# Seed (`pnpm db:seed`, scripts/deploy/supabase-setup.mjs): production skips the demo restaurant and
# the demo dispatcher; SEED_ADMIN_PHONE (your mobile) becomes admin + dispatcher + support + finance.
# SEED_PROFILE=production
# SEED_ADMIN_PHONE=07XXXXXXXXX
# SEED_ADMIN_NAME=
# Build-time, not runtime: the Expo apps read EXPO_PUBLIC_API_URL / EXPO_PUBLIC_SHARE_BASE_URL when
# bundling (web export, EAS); the Console reads NEXT_PUBLIC_API_URL and NEXT_OUTPUT=standalone in `next build`.
# EXPO_PUBLIC_API_URL=https://api.example.com/trpc
# EXPO_PUBLIC_SHARE_BASE_URL=https://app.example.com
# NEXT_OUTPUT=standalone

# Offline Prisma CLI (no engine download, no database) — only for CI/sandboxes without Postgres.
# PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1
# PRISMA_SCHEMA_ENGINE_BINARY=/bin/true
