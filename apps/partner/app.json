{
  "expo": {
    "name": "درايفر بارتنر",
    "slug": "driver-partner",
    "scheme": "driver-partner",
    "version": "0.1.0",
    "runtimeVersion": { "policy": "fingerprint" },
    "updates": { "enabled": true, "checkAutomatically": "ON_LOAD", "fallbackToCacheTimeout": 0 },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "locales": { "ar": "./locales/ar.json" },
    "extra": {
      "apiUrl": "http://localhost:3000/trpc",
      "supportsRTL": true,
      "forcesRTL": true
    },
    "ios": {
      "bundleIdentifier": "iq.driver.partner",
      "supportsTablet": true,
      "infoPlist": { "CFBundleDevelopmentRegion": "ar", "CFBundleLocalizations": ["ar", "en"], "LSApplicationQueriesSchemes": ["comgooglemaps", "waze"] }
    },
    "android": {
      "package": "iq.driver.partner"
    },
    "plugins": [
      "expo-router",
      ["expo-localization", {}],
      [
        "expo-image-picker",
        {
          "photosPermission": "درايفر بارتنر يحتاج صورك حتى ترفع صورة التسليم والمستمسكات",
          "cameraPermission": "درايفر بارتنر يحتاج الكاميرا حتى تصوّر الطلب عند التسليم وتسوي التحقق اليومي"
        }
      ],
      ["expo-location", { "locationWhenInUsePermission": "درايفر بارتنر يحتاج موقعك حتى يوصلك طلبات قريبة ويعرف الزبون وين صرت" }],
      ["expo-notifications", { "sounds": ["./assets/sounds/offer.wav"], "defaultChannel": "offers" }],
      "expo-font",
      "expo-secure-store",
      ["expo-audio", { "microphonePermission": false }],
      "expo-asset"
    ],
    "experiments": { "typedRoutes": true }
  }
}
