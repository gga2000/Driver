{
  "expo": {
    "name": "درايفر بارتنر",
    "slug": "driver-partner",
    "scheme": "driver-partner",
    "version": "0.1.0",
    "runtimeVersion": { "policy": "fingerprint" },
    "updates": { "enabled": true, "checkAutomatically": "ON_LOAD", "fallbackToCacheTimeout": 0 },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "locales": { "ar": "./locales/ar.json" },
    "extra": {
      "apiUrl": "http://localhost:3000/trpc",
      "supportsRTL": true,
      "forcesRTL": true
    },
    "ios": {
      "bundleIdentifier": "iq.driver.partner",
      "supportsTablet": true,
      "infoPlist": { "CFBundleDevelopmentRegion": "ar", "CFBundleLocalizations": ["ar", "en"], "LSApplicationQueriesSchemes": ["comgooglemaps", "waze"] }
    },
    "android": {
      "package": "iq.driver.partner"
    },
    "plugins": [
      "expo-router",
      ["expo-localization", {}],
      [
        "expo-image-picker",
        {
          "photosPermission": "درايفر بارتنر يحتاج صورك حتى ترفع صورة التسليم والمستمسكات",
          "cameraPermission": "درايفر بارتنر يحتاج الكاميرا حتى تصوّر الطلب عند التسليم وتسوي التحقق اليومي"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "درايفر بارتنر يحتاج موقعك حتى يوصلك طلبات قريبة ويعرف الزبون وين صرت",
          "locationAlwaysAndWhenInUsePermission": "درايفر بارتنر يحتاج موقعك طول ما انت شغّال أو عندك طلب، حتى لو سدّيت التطبيق، حتى توصلك طلبات ويشوف الزبون وين صرت",
          "locationAlwaysPermission": "درايفر بارتنر يحتاج موقعك طول ما انت شغّال أو عندك طلب، حتى لو سدّيت التطبيق، حتى توصلك طلبات ويشوف الزبون وين صرت",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      ["expo-notifications", { "sounds": ["./assets/sounds/offer.wav"], "defaultChannel": "offers" }],
      ["expo-font", {"android": {"fonts": ["./node_modules/@expo-google-fonts/ibm-plex-sans-arabic/400Regular/IBMPlexSansArabic_400Regular.ttf", "./node_modules/@expo-google-fonts/ibm-plex-sans-arabic/500Medium/IBMPlexSansArabic_500Medium.ttf", "./node_modules/@expo-google-fonts/ibm-plex-sans-arabic/600SemiBold/IBMPlexSansArabic_600SemiBold.ttf", "./node_modules/@expo-google-fonts/ibm-plex-sans-arabic/700Bold/IBMPlexSansArabic_700Bold.ttf"]}}],
      ["expo-build-properties", {"android": {"enableMinifyInReleaseBuilds": true, "enableShrinkResourcesInReleaseBuilds": true}}],
      "expo-secure-store",
      ["expo-audio", { "microphonePermission": "درايفر بارتنر يحتاج المايك حتى تدز رسالة صوتية للزبون. يشتغل بس وانت ضاغط عليه", "recordAudioAndroid": true, "enableBackgroundPlayback": false }],
      "expo-asset",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": { "typedRoutes": true }
  }
}
