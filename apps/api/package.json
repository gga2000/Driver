{
  "name": "@driver/api",
  "version": "0.1.0",
  "private": true,
  "description": "Driver API — NestJS modular monolith exposing tRPC",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch --import @swc-node/register/esm-register src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "sim": "node --import @swc-node/register/esm-register src/sim.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@driver/contracts": "workspace:*",
    "@driver/db": "workspace:*",
    "@driver/i18n": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@trpc/server": "11.19.0",
    "bullmq": "6.3.11",
    "compression": "1.8.2",
    "express": "5.2.1",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/testing": "11.2.7",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.13",
    "@trpc/client": "11.19.0",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "5.4.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "unplugin-swc": "2.0.0",
    "vitest": "3.2.7"
  }
}
