{
  "expo": {
    "name": "درايفر",
    "slug": "driver-customer",
    "scheme": "driver",
    "version": "0.1.0",
    "runtimeVersion": { "policy": "fingerprint" },
    "updates": { "enabled": true, "checkAutomatically": "ON_LOAD", "fallbackToCacheTimeout": 0 },
    "orientation": "portrait",
    "web": {
      "name": "درايفر",
      "shortName": "درايفر",
      "lang": "ar",
      "themeColor": "#FBF6EE",
      "backgroundColor": "#FBF6EE"
    },
    "userInterfaceStyle": "light",
    "locales": { "ar": "./locales/ar.json" },
    "extra": {
      "apiUrl": "http://localhost:3000/trpc",
      "supportsRTL": true,
      "forcesRTL": true
    },
    "ios": {
      "bundleIdentifier": "iq.driver.customer",
      "supportsTablet": true,
      "infoPlist": { "CFBundleDevelopmentRegion": "ar", "CFBundleLocalizations": ["ar", "en"] }
    },
    "android": {
      "package": "iq.driver.customer"
    },
    "plugins": [
      "expo-router",
      ["expo-localization", {}],
      [
        "expo-image-picker",
        {
          "photosPermission": "درايفر يحتاج صورك حتى تضيف صورة باب البيت للدليفري",
          "cameraPermission": "درايفر يحتاج الكاميرا حتى تصوّر باب البيت للدليفري"
        }
      ],
      ["expo-location", { "locationWhenInUsePermission": "درايفر يحتاج موقعك حتى يثبّت مكان بيتك ويوصلك الدليفري للباب" }],
      ["expo-notifications", { "defaultChannel": "orders", "sounds": ["./assets/sounds/placed.wav", "./assets/sounds/accepted.wav", "./assets/sounds/picked_up.wav", "./assets/sounds/near.wav", "./assets/sounds/delivered.wav"] }],
      "expo-font",
      "expo-secure-store",
      ["expo-audio", { "microphonePermission": "درايفر يحتاج المايك حتى تدز رسالة صوتية للسايق أو للدعم. يشتغل بس وانت ضاغط عليه", "recordAudioAndroid": true, "enableBackgroundPlayback": false }],
      "expo-asset",
      "expo-status-bar",
      "expo-sharing",
      "expo-quick-actions"
    ],
    "experiments": { "typedRoutes": true }
  }
}
