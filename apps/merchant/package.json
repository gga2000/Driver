{
  "name": "@driver/merchant",
  "version": "0.1.0",
  "private": true,
  "description": "Driver Merchant app (Expo) — restaurants and grocers: orders board, menu, money (phone + tablet)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web --output-dir dist-web",
    "web:shots": "node scripts/web-shots.mjs",
    "demo-api": "node scripts/demo-api.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint app src scripts",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@driver/contracts": "workspace:*",
    "@driver/design-tokens": "workspace:*",
    "@driver/i18n": "workspace:*",
    "@driver/ui": "workspace:*",
    "@expo-google-fonts/ibm-plex-sans-arabic": "0.4.2",
    "@expo/metro-runtime": "55.0.12",
    "@react-native-community/netinfo": "11.5.2",
    "@tanstack/react-query": "5.104.1",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "@trpc/tanstack-react-query": "11.19.0",
    "expo": "55.0.31",
    "expo-asset": "55.0.20",
    "expo-audio": "55.0.18",
    "expo-constants": "55.0.17",
    "expo-font": "55.0.8",
    "expo-haptics": "55.0.18",
    "expo-image-picker": "55.0.24",
    "expo-keep-awake": "55.0.8",
    "expo-linking": "55.0.17",
    "expo-localization": "55.0.19",
    "expo-notifications": "55.0.27",
    "expo-router": "55.0.18",
    "expo-secure-store": "55.0.18",
    "expo-status-bar": "55.0.6",
    "expo-updates": "55.0.33",
    "query-string": "7.1.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "2.30.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "0.21.3",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "9.39.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "3.2.7"
  }
