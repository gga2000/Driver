{
  "name": "@driver/merchant",
  "version": "0.1.0",
  "private": true,
  "description": "Driver Merchant app (Expo) — restaurants and grocers: orders board, menu, money (phone + tablet)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web --output-dir dist-web",
    "web:shots": "node scripts/web-shots.mjs",
    "demo-api": "node scripts/demo-api.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint app src scripts",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@driver/contracts": "workspace:*",
    "@driver/design-tokens": "workspace:*",
    "@driver/i18n": "workspace:*",
    "@driver/ui": "workspace:*",
    "@expo-google-fonts/ibm-plex-sans-arabic": "0.4.2",
    "@expo/metro-runtime": "56.0.21",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "5.104.1",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "@trpc/tanstack-react-query": "11.19.0",
    "expo": "56.0.23",
    "expo-asset": "56.0.25",
    "expo-audio": "56.0.13",
    "expo-constants": "56.0.27",
    "expo-font": "56.0.7",
    "expo-haptics": "56.0.3",
    "expo-image-picker": "56.0.25",
    "expo-keep-awake": "56.0.3",
    "expo-linking": "56.0.18",
    "expo-localization": "56.0.6",
    "expo-notifications": "56.0.26",
    "expo-router": "56.2.21",
    "expo-secure-store": "56.0.4",
    "expo-status-bar": "56.0.4",
    "expo-updates": "56.0.28",
    "query-string": "7.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "2.31.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.3",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "9.39.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "3.2.7"
  }
}
