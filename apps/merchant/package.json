{
  "name": "@driver/merchant",
  "version": "0.1.0",
  "private": true,
  "description": "Driver Merchant app (Expo) — restaurants and grocers: orders board, menu, money (phone + tablet)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web --output-dir dist-web",
    "web:shots": "node scripts/web-shots.mjs",
    "demo-api": "node scripts/demo-api.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint app src scripts",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@driver/contracts": "workspace:*",
    "@driver/design-tokens": "workspace:*",
    "@driver/i18n": "workspace:*",
    "@driver/ui": "workspace:*",
    "@expo-google-fonts/ibm-plex-sans-arabic": "0.4.2",
    "@expo/metro-runtime": "6.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "@tanstack/react-query": "5.104.1",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "@trpc/tanstack-react-query": "11.19.0",
    "expo": "54.0.37",
    "expo-asset": "12.0.13",
    "expo-audio": "1.1.1",
    "expo-constants": "18.0.14",
    "expo-font": "14.0.12",
    "expo-haptics": "15.0.8",
    "expo-image-picker": "17.0.11",
    "expo-keep-awake": "15.0.8",
    "expo-linking": "8.0.12",
    "expo-localization": "17.0.9",
    "expo-notifications": "0.32.17",
    "expo-router": "6.0.24",
    "expo-secure-store": "15.0.8",
    "expo-status-bar": "3.0.9",
    "expo-updates": "29.0.20",
    "query-string": "7.1.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "2.28.0",
    "react-native-reanimated": "4.1.7",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "0.21.3",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "9.39.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "3.2.7"
  }
}
