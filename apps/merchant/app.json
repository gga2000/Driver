{
  "expo": {
    "name": "درايفر للمطاعم",
    "slug": "driver-merchant",
    "scheme": "driver-merchant",
    "version": "0.1.0",
    "runtimeVersion": { "policy": "fingerprint" },
    "updates": { "enabled": true, "checkAutomatically": "ON_LOAD", "fallbackToCacheTimeout": 0 },
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "locales": { "ar": "./locales/native/ar.json" },
    "extra": {
      "apiUrl": "http://localhost:3000/trpc",
      "supportsRTL": true,
      "forcesRTL": true
    },
    "ios": {
      "bundleIdentifier": "iq.driver.merchant",
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ar",
        "CFBundleLocalizations": ["ar", "en"],
        "NSBluetoothAlwaysUsageDescription": "درايفر للمطاعم يحتاج البلوتوث حتى يطبع الطلبات على طابعة المطبخ"
      }
    },
    "android": {
      "package": "iq.driver.merchant",
      "permissions": ["BLUETOOTH_CONNECT", "BLUETOOTH_SCAN", "VIBRATE"]
    },
    "web": { "name": "درايفر للمطاعم", "shortName": "درايفر للمطاعم", "lang": "ar", "themeColor": "#FBF6EE", "backgroundColor": "#FBF6EE" },
    "plugins": [
      "expo-router",
      ["expo-localization", {}],
      ["expo-image-picker", { "photosPermission": "درايفر للمطاعم يحتاج صورك حتى ترفع صور الأكل والمنيو", "cameraPermission": "درايفر للمطاعم يحتاج الكاميرا حتى تصوّر الأكل والمنيو" }],
      ["expo-notifications", { "sounds": ["./assets/sounds/offer.wav"], "defaultChannel": "offers" }],
      "expo-font",
      "expo-secure-store",
      ["expo-audio", { "microphonePermission": false }],
      "expo-asset"
    ],
    "experiments": { "typedRoutes": true }
  }
}
